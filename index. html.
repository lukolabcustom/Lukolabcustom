<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Luko Lab Custom</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #07150d;
      color: #f4f0e5;
      font-family: Arial, sans-serif;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 6%;
      background: rgba(5, 15, 9, 0.92);
      border-bottom: 1px solid #29452f;
    }

    .logo {
      font-weight: bold;
      letter-spacing: 3px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 20px;
    }

    .hero {
      min-height: 75vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 20px;
      background:
        radial-gradient(circle at center, #1d4a2b 0%, #07150d 65%);
    }

    .hero h1 {
      font-size: clamp(45px, 10vw, 100px);
      margin: 0;
      letter-spacing: 8px;
    }

    .hero p {
      max-width: 600px;
      margin: 25px auto;
      color: #c4c8bd;
      font-size: 18px;
      line-height: 1.6;
    }

    .button {
      display: inline-block;
      padding: 14px 25px;
      border: 1px solid #d7b86a;
      border-radius: 30px;
      background: transparent;
      color: white;
      cursor: pointer;
      text-decoration: none;
    }

    main {
      max-width: 1200px;
      margin: auto;
      padding: 70px 6%;
    }

    h2 {
      font-size: 35px;
    }

    .filters {
      display: flex;
      gap: 10px;
      margin: 30px 0;
      flex-wrap: wrap;
    }

    .filters button {
      padding: 10px 18px;
      border-radius: 25px;
      border: 1px solid #38563e;
      background: transparent;
      color: white;
      cursor: pointer;
    }

    .filters button.active {
      border-color: #d7b86a;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 25px;
    }

    .product {
      background: #0d2116;
      border: 1px solid #29452f;
      border-radius: 18px;
      overflow: hidden;
    }

    .product-image {
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #142c1c;
      color: #899a8c;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-info {
      padding: 18px;
    }

    .product-info h3 {
      margin-top: 0;
    }

    .price {
      color: #d7b86a;
      font-weight: bold;
      font-size: 18px;
    }

    .cart-button {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 20;
      border: 0;
      border-radius: 30px;
      padding: 15px 22px;
      background: #d7b86a;
      color: #151109;
      font-weight: bold;
      cursor: pointer;
    }

    .cart {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 30;
      background: rgba(0,0,0,.75);
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .cart.open {
      display: flex;
    }

    .cart-box {
      width: 100%;
      max-width: 500px;
      background: #0d2116;
      border: 1px solid #38563e;
      border-radius: 20px;
      padding: 25px;
    }

    .cart-item {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid #29452f;
    }

    footer {
      text-align: center;
      padding: 50px 20px;
      border-top: 1px solid #29452f;
      color: #8f998f;
    }
  </style>
</head>

<body>

<header>
  <div class="logo">LUKO LAB CUSTOM</div>

  <nav>
    <a href="#shop">SHOP</a>
    <a href="#lab">IL LAB</a>
  </nav>
</header>

<section class="hero">

  <div>
    <h1>LUKO LAB</h1>

    <p>
      Handmade pieces created inside our tropical laboratory.
      Ogni pezzo nasce a mano.
    </p>

    <a class="button" href="#shop">
      ENTRA NEL LAB
    </a>
  </div>

</section>

<main>

<section id="shop">

  <h2>SHOP</h2>

  <p>
    Cappelli handmade — €35
  </p>

  <div class="filters">

    <button class="active" onclick="showCategory('all', this)">
      TUTTI
    </button>

    <button onclick="showCategory('Cappelli', this)">
      CAPPELLI
    </button>

    <button onclick="showCategory('Abbigliamento', this)">
      ABBIGLIAMENTO
    </button>

  </div>

  <div class="products" id="products"></div>

</section>

<section id="lab">

  <h2>IL LAB</h2>

  <p>
    Luko Lab Custom è un laboratorio indipendente dove ogni prodotto
    viene realizzato a mano.
  </p>

</section>

</main>

<button class="cart-button" onclick="openCart()">
  CARRELLO (<span id="cartCount">0</span>)
</button>

<div class="cart" id="cart">

  <div class="cart-box">

    <h2>Il tuo carrello</h2>

    <div id="cartItems"></div>

    <h3>
      Totale: €<span id="total">0</span>
    </h3>

    <button class="button" onclick="checkout()">
      PAGAMENTO CON CARTA
    </button>

    <button
      class="button"
      onclick="closeCart()"
      style="margin-left:10px"
    >
      CHIUDI
    </button>

  </div>

</div>

<footer>
  © Luko Lab Custom
</footer>

<script>

const products = [

  {
    id: 1,
    name: "Cappello Luko Lab 01",
    category: "Cappelli",
    price: 35
  },

  {
    id: 2,
    name: "Cappello Luko Lab 02",
    category: "Cappelli",
    price: 35
  },

  {
    id: 3,
    name: "Cappello Luko Lab 03",
    category: "Cappelli",
    price: 35
  },

  {
    id: 4,
    name: "Cappello Luko Lab 04",
    category: "Cappelli",
    price: 35
  },

  {
    id: 5,
    name: "Cappello Luko Lab 05",
    category: "Cappelli",
    price: 35
  },

  {
    id: 6,
    name: "Cappello Luko Lab 06",
    category: "Cappelli",
    price: 35
  },

  {
    id: 7,
    name: "Cappello Luko Lab 07",
    category: "Cappelli",
    price: 35
  },

  {
    id: 8,
    name: "Cappello Luko Lab 08",
    category: "Cappelli",
    price: 35
  },

  {
    id: 9,
    name: "Cappello Luko Lab 09",
    category: "Cappelli",
    price: 35
  },

  {
    id: 10,
    name: "Cappello Luko Lab 10",
    category: "Cappelli",
    price: 35
  },

  {
    id: 11,
    name: "Cappello Luko Lab 11",
    category: "Cappelli",
    price: 35
  },

  {
    id: 12,
    name: "Cappello Luko Lab 12",
    category: "Cappelli",
    price: 35
  },

  {
    id: 13,
    name: "Cappello Luko Lab 13",
    category: "Cappelli",
    price: 35
  },

  {
    id: 14,
    name: "Cappello Luko Lab 14",
    category: "Cappelli",
    price: 35
  }

];

let cart = [];

function renderProducts(list) {

  const container = document.getElementById("products");

  container.innerHTML = "";

  list.forEach(product => {

    container.innerHTML += `

      <article class="product">

        <div class="product-image">
          FOTO PRODOTTO
        </div>

        <div class="product-info">

          <h3>${product.name}</h3>

          <div class="price">
            €${product.price}
          </div>

          <br>

          <button
            class="button"
            onclick="addToCart(${product.id})"
          >
            AGGIUNGI AL CARRELLO
          </button>

        </div>

      </article>

    `;

  });

}

function showCategory(category, button) {

  document
    .querySelectorAll(".filters button")
    .forEach(b => b.classList.remove("active"));

  button.classList.add("active");

  if (category === "all") {
    renderProducts(products);
  } else {
    renderProducts(
      products.filter(p => p.category === category)
    );
  }

}

function addToCart(id) {

  const product = products.find(p => p.id === id);

  cart.push(product);

  updateCart();

  openCart();

}

function updateCart() {

  document.getElementById("cartCount").textContent =
    cart.length;

  const container =
    document.getElementById("cartItems");

  container.innerHTML = "";

  let total = 0;

  cart.forEach((product, index) => {

    total += product.price;

    container.innerHTML += `

      <div class="cart-item">

        <span>${product.name}</span>

        <span>
          €${product.price}
          <button onclick="removeFromCart(${index})">
            ×
          </button>
        </span>

      </div>

    `;

  });

  document.getElementById("total").textContent =
    total.toFixed(2);

}

function removeFromCart(index) {

  cart.splice(index, 1);

  updateCart();

}

function openCart() {

  document
    .getElementById("cart")
    .classList.add("open");

}

function closeCart() {

  document
    .getElementById("cart")
    .classList.remove("open");

}

function checkout() {

  alert(
    "Il pagamento con carta verrà collegato a Stripe nel prossimo passaggio."
  );

}

renderProducts(products);

</script>

</body>
</html>
